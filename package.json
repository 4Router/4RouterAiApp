{
    "name": "4routerai",
    "version": "1.2.5",
    "description": "All-in-one AI coding assistant — Claude Code & Codex in a single app",
    "engines": {
        "node": ">=20"
    },
    "main": "dist/main/index.js",
    "scripts": {
        "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
        "dev:main": "tsc -p tsconfig.main.json --watch",
        "dev:renderer": "vite dev",
        "build": "npm run build:main && npm run build:renderer",
        "build:main": "tsc -p tsconfig.main.json",
        "build:renderer": "vite build",
        "bundle-tools": "node scripts/bundle-tools.mjs",
        "verify": "npm run build && node scripts/verify-web-auth.cjs && node scripts/verify-version.cjs && node scripts/verify-codex-config.cjs",
        "verify:remote": "npm run build && node scripts/verify-web-auth.cjs",
        "package": "npm run build && npm run bundle-tools && electron-builder --win",
        "package:mac": "bash scripts/build-mac.sh",
        "start": "electron .",
        "start:dev": "electron . --dev"
    },
    "author": "4RouterAi",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@types/ws": "^8.18.1",
        "@xterm/headless": "^5.5.0",
        "concurrently": "^8.2.2",
        "electron": "^33.0.0",
        "electron-builder": "^25.1.0",
        "typescript": "^5.5.0",
        "vite": "^6.0.0"
    },
    "dependencies": {
        "@peculiar/x509": "^1.14.3",
        "@xterm/addon-fit": "^0.10.0",
        "@xterm/addon-unicode11": "^0.8.0",
        "@xterm/addon-web-links": "^0.11.0",
        "@xterm/xterm": "^5.5.0",
        "electron-store": "^8.2.0",
        "node-pty": "1.2.0-beta.13",
        "ws": "^8.21.0"
    },
    "build": {
        "appId": "com.4routerai.app",
        "productName": "4RouterAi",
        "npmRebuild": false,
        "directories": {
            "output": "release"
        },
        "afterPack": "scripts/mac-adhoc-sign.cjs",
        "win": {
            "icon": "resources/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "deleteAppDataOnUninstall": true
        },
        "mac": {
            "icon": "resources/icon.icns",
            "category": "public.app-category.developer-tools",
            "target": [
                "dmg"
            ],
            "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "extendInfo": {
                "NSDocumentsFolderUsageDescription": "4RouterAi 中运行的终端与 AI 编程工具需要读写你在“文稿”中的项目文件。",
                "NSDesktopFolderUsageDescription": "4RouterAi 中运行的终端与 AI 编程工具需要读写你在“桌面”上的项目文件。",
                "NSDownloadsFolderUsageDescription": "4RouterAi 中运行的终端与 AI 编程工具需要读写“下载”文件夹中的文件。",
                "NSRemovableVolumesUsageDescription": "4RouterAi 中运行的终端与 AI 编程工具需要访问可移除宗卷上的项目文件。",
                "NSNetworkVolumesUsageDescription": "4RouterAi 中运行的终端与 AI 编程工具需要访问网络宗卷上的项目文件。",
                "NSLocalNetworkUsageDescription": "远程访问功能需要让局域网内的设备连接到 4RouterAi。"
            }
        },
        "dmg": {
            "title": "${productName} ${version}",
            "writeUpdateInfo": false
        },
        "asar": true,
        "asarUnpack": [
            "resources/bundled-tools/**",
            "node_modules/node-pty/**"
        ],
        "extraResources": [
            {
                "from": "resources/bundled-tools",
                "to": "bundled-tools"
            }
        ],
        "files": [
            "dist/**/*",
            "resources/**/*",
            "!resources/bundled-tools{,/**/*}"
        ]
    }
}
